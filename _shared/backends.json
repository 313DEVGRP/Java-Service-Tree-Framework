{
  "schema_version": "1",
  "flavor": "claude",
  "multiagent_root_env": "MULTIAGENT_ROOT",
  "workers": {
    "claude-main": {
      "model": "host-default",
      "call_type": "native",
      "native": {
        "subagent_type": "claude-main",
        "prompt_source": "brief",
        "model_alias": "opus"
      },
      "approval_class": "worker",
      "result_capture": "orchestrator"
    },
    "claude-reviewer": {
      "model": "claude-sonnet-5",
      "call_type": "native",
      "native": {
        "subagent_type": "claude-reviewer",
        "prompt_source": "brief",
        "model_alias": "claude-sonnet-5"
      },
      "approval_class": "worker",
      "result_capture": "orchestrator"
    }
  }
}
